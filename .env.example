APP_NAME=eve-quartermaster
EVE_SSO_CLIENT_ID=
EVE_SSO_CLIENT_SECRET=
EVE_SSO_CALLBACK_URL=http://localhost:8000/api/esi/auth/callback
ESI_COMPATIBILITY_DATE=2026-07-22
ESI_MAX_CONNECTIONS=8
ESI_RATE_LIMIT_CUSHION=0.05
TOKEN_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173
AUTH_SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=720
SDE_SOURCE_PATH=/sde
SDE_HOST_PATH=./sde
KILLBOARD_ENABLED_DEFAULT=true
KILLBOARD_SYNC_PERIOD_HOURS_DEFAULT=6
KILLBOARD_LOOKBACK_DAYS_DEFAULT=90
KILLBOARD_REQUEST_DELAY_SECONDS_DEFAULT=1.0
KILLBOARD_MAX_PAGES_DEFAULT=10
EQM_PI_ENGINE=rust
EQM_PI_PLANNER_ENGINE=rust
EQM_FITTING_ENGINE=rust
EQM_FITTING_STATS_ENGINE=rust
EQM_ANALYTICS_ENGINE=rust
EQM_BOUNTY_ANALYTICS_ENGINE=rust
EQM_JUMP_ROUTE_ENGINE=rust
EQM_SETTLEMENT_MATH_ENGINE=rust
EQM_KILLBOARD_ANALYTICS_ENGINE=rust
EQM_SRP_ANALYTICS_ENGINE=rust
EQM_BATTLE_REPORT_ENGINE=rust
EQM_HYPERNET_ENGINE=rust
EQM_THREAT_ANALYTICS_ENGINE=rust
EQM_EVENT_ANALYTICS_ENGINE=rust
EQM_PLANETARY_ANALYTICS_ENGINE=rust
EQM_FINANCIAL_ANALYTICS_ENGINE=rust
EQM_CORE_BINARY=/usr/local/bin/eqm-core
EQM_CORE_TIMEOUT_SECONDS=5


# Per-process database pool; overflow connections are released after bursts.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=900
DB_IDLE_TRANSACTION_TIMEOUT_SECONDS=300
DB_WORKER_POOL_SIZE=3
DB_WORKER_MAX_OVERFLOW=7
DB_WATCHDOG_ENABLED=true
DB_WATCHDOG_INTERVAL_SECONDS=60
DB_WATCHDOG_IDLE_SECONDS=300
DB_WATCHDOG_QUERY_SECONDS=180

# Password recovery: SMTP uses STARTTLS, or implicit TLS with SMTP_SSL=true.
PASSWORD_RESET_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false

# Worker-backed SDE maintenance
SDE_DOWNLOAD_PATH=/sde/downloads
SDE_JOB_TIMEOUT_SECONDS=7200
SDE_DOWNLOAD_MAX_BYTES=536870912
